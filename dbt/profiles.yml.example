# Copy to ~/.dbt/profiles.yml (or set DBT_PROFILES_DIR).
# Target warehouse in Foundation Development is warehouse_stage.

foundation:
  target: dev
  outputs:
    dev:
      type: fabric
      driver: "ODBC Driver 18 for SQL Server"
      server: "cx2knzbh2yrejngvheequwseqy-mqufaqgon22utad7n56bdunt4e.datawarehouse.fabric.microsoft.com"
      port: 1433
      database: "warehouse_stage"
      schema: "analytics"
      authentication: CLI
      encrypt: true
      trust_cert: true
      threads: 4
      query_timeout: 300
    # CI target: same warehouse, service-principal auth once sp-identity lands.
    ci:
      type: fabric
      driver: "ODBC Driver 18 for SQL Server"
      server: "cx2knzbh2yrejngvheequwseqy-mqufaqgon22utad7n56bdunt4e.datawarehouse.fabric.microsoft.com"
      port: 1433
      database: "warehouse_stage"
      schema: "analytics"
      authentication: ServicePrincipal
      tenant_id: "{{ env_var('AZURE_TENANT_ID') }}"
      client_id: "{{ env_var('AZURE_CLIENT_ID') }}"
      client_secret: "{{ env_var('AZURE_CLIENT_SECRET') }}"
      encrypt: true
      trust_cert: true
      threads: 4
      query_timeout: 300
