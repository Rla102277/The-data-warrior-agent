{
  "name": "pl_legacy_stage_entity_load",
  "properties": {
    "parameters": {
      "entityName": { "type": "string" }
    },
    "variables": {
      "runId": { "type": "String" }
    },
    "activities": [
      {
        "name": "LookupConfig",
        "type": "Lookup",
        "dependsOn": [],
        "policy": { "retry": 1, "timeout": "0.00:10:00" },
        "inputs": [
          { "referenceName": "ds_stage_load_config", "type": "DatasetReference" }
        ],
        "typeProperties": {
          "source": { "type": "SqlServerSource" }
        }
      },
      {
        "name": "CopyEntity",
        "type": "Copy",
        "dependsOn": [
          { "activity": "LookupConfig", "dependencyConditions": ["Succeeded"] }
        ],
        "policy": { "retry": 1, "timeout": "0.00:10:00" },
        "inputs": [
          { "referenceName": "ds_source_entity", "type": "DatasetReference" }
        ],
        "outputs": [
          { "referenceName": "ds_stage_entity", "type": "DatasetReference" }
        ],
        "typeProperties": {
          "source": { "type": "SqlServerSource" },
          "sink": { "type": "SqlServerSink" }
        }
      },
      {
        "name": "InvokeChild",
        "type": "ExecutePipeline",
        "dependsOn": [
          { "activity": "CopyEntity", "dependencyConditions": ["Succeeded"] }
        ],
        "typeProperties": {
          "pipeline": { "referenceName": "pl_audit_wrapper", "type": "PipelineReference" }
        }
      }
    ]
  }
}
