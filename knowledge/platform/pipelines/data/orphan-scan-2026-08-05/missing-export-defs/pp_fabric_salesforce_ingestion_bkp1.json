      {
        "name": "filter_updates",
        "description": "filter to run updates on salesforce objects",
        "type": "Filter",
        "dependsOn": [
          {
            "activity": "lkp_get_tablelist",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('lkp_get_tablelist').output.value",
            "type": "Expression"
          },
          "condition": {
