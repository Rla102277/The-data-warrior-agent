              "linkedService": {
                "name": "Salesforce_WH",
                "properties": {
                  "annotations": [],
                  "type": "DataWarehouse",
                  "typeProperties": {
                    "endpoint": "cx2knzbh2yrejngvheequwseqy-mpsfzbl7atie7hr6l3lpvtholy.datawarehouse.fabric.microsoft.com",
                    "artifactId": "adfe4a3b-9adc-4661-a8b7-f4ef7fcf7059",
                    "workspaceId": "855ce463-047f-4fd0-9e3e-5ed6faccee5e"
                  }
                }
              },
              "typeProperties": {
                "scripts": [
                  {
                    "type": "Query",
                    "text": {
                      "value": "INSERT INTO logging.Pipeline_Table_Run_Log\n(\n    LogId,\n    PipelineName,\n    PipelineType,\n    TargetSystem,\n    LoadType,\n    PipelineRunId,\n    TableName,\n    ActivityName,\n    StartTime,\n    RunStatus,\n    CreatedDatetime\n)\nVALUES\n(\n    '@{variables('LogId')}',\n    '@{pipeline().Pipeline}',\n    '@{item().Pipeline_Type}',\n    'Salesforce',\n    '@{item().Load_Type}',\n    '@{pipeline().RunId}',\n    '@{item().Target_Table_Name}',\n    'updates_fabric_salesforce',\n    SYSUTCDATETIME(),\n    'Started',\n    SYSUTCDATETIME()\n);\n",
                      "type": "Expression"
                    }
                  }
                ],
                "scriptBlockExecutionTimeout": "02:00:00"
              }
            },
            {
              "name": "set_logid",
              "type": "SetVariable",
              "dependsOn": [],
              "policy": {
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "variableName": "LogId",
                "value": {
                  "value": "@{guid()}",
                  "type": "Expression"
                }
              }
            },
            {
              "name": "log_succed",
              "type": "Script",
              "dependsOn": [
                {
                  "activity": "updates_fabric_salesforce",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
