              ],
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "linkedService": {
                "name": "Salesforce_WH",
                "properties": {
                  "annotations": [],
                  "type": "DataWarehouse",
                  "typeProperties": {
                    "endpoint": "cx2knzbh2yrejngvheequwseqy-mpsfzbl7atie7hr6l3lpvtholy.datawarehouse.fabric.microsoft.com",
                    "artifactId": "adfe4a3b-9adc-4661-a8b7-f4ef7fcf7059",
                    "workspaceId": "855ce463-047f-4fd0-9e3e-5ed6faccee5e"
                  }
                }
              },
              "typeProperties": {
                "scripts": [
                  {
                    "type": "Query",
                    "text": {
                      "value": "UPDATE logging.Pipeline_Table_Run_Log\nSET\n    EndTime = SYSUTCDATETIME(),\n    RunStatus = 'Success',\n    RowsRead = @{activity('updates_fabric_salesforce').output.rowsRead},\n    RowsWritten = @{activity('updates_fabric_salesforce').output.rowsCopied},\n    RowsSkipped = @{activity('updates_fabric_salesforce').output.rowsSkipped}\nWHERE \n    LogId = '@{variables('LogId')}'\n    AND PipelineRunId = '@{pipeline().RunId}'\n    AND TableName = '@{item().Target_Table_Name}'\n    AND RunStatus = 'Started';\n",
                      "type": "Expression"
                    }
                  }
                ],
                "scriptBlockExecutionTimeout": "02:00:00"
              }
            },
            {
              "name": "log_failure",
              "type": "Script",
              "dependsOn": [
                {
                  "activity": "updates_fabric_salesforce",
                  "dependencyConditions": [
                    "Failed"
                  ]
                }
              ],
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "linkedService": {
                "name": "Salesforce_WH",
                "properties": {
                  "annotations": [],
                  "type": "DataWarehouse",
                  "typeProperties": {
                    "endpoint": "cx2knzbh2yrejngvheequwseqy-mpsfzbl7atie7hr6l3lpvtholy.datawarehouse.fabric.microsoft.com",
                    "artifactId": "adfe4a3b-9adc-4661-a8b7-f4ef7fcf7059",
                    "workspaceId": "855ce463-047f-4fd0-9e3e-5ed6faccee5e"
                  }
                }
              },
              "typeProperties": {
                "scripts": [
                  {
                    "type": "Query",
                    "text": {
                      "value": "UPDATE logging.Pipeline_Table_Run_Log\nSET\n    EndTime = SYSUTCDATETIME(),\n    RunStatus = 'Failed',\n    ErrorMessage = '@{replace(coalesce(activity('updates_fabric_salesforce').error.message, 'Unknown error'), '''', '''''')}'\nWHERE\n    LogId = '@{variables('LogId')}'\n    AND PipelineRunId = '@{pipeline().RunId}'\n    AND TableName = '@{item().Target_Table_Name}'\n    AND RunStatus = 'Started';\n",
                      "type": "Expression"
                    }
                  }
                ],
                "scriptBlockExecutionTimeout": "02:00:00"
              }
            }
          ]
        }
