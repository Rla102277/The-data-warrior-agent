{
  "properties": {
    "activities": [
      {
        "name": "lkp_get_tablelist",
        "description": "Get the fabric views table name and details from Ingestion_Config table",
        "type": "Lookup",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "DataWarehouseSource",
            "sqlReaderQuery": "SELECT \n    Pipeline_Type,\n    Pipeline_Name,\n    Source_Schema,\n    Source_Table_Name,\n    Target_Schema,\n    Target_Table_Name,\n    Table_Fields,\n    Primary_Key,\n    Join_Definition,\n    Watermark_Fields,\n    IsActive,\n    Load_Type \nFROM [metadata].[Ingestion_Config] WHERE Pipeline_Type='Outbound' and Target_Table_Name IN ('Vendor_Lot_Relationship');",
            "queryTimeout": "02:00:00",
            "partitionOption": "None"
          },
          "firstRowOnly": false,
          "datasetSettings": {
            "annotations": [],
            "linkedService": {
              "name": "Salesforce_WH",
              "properties": {
                "annotations": [],
                "type": "DataWarehouse",
                "typeProperties": {
                  "endpoint": "cx2knzbh2yrejngvheequwseqy-mpsfzbl7atie7hr6l3lpvtholy.datawarehouse.fabric.microsoft.com",
                  "artifactId": "adfe4a3b-9adc-4661-a8b7-f4ef7fcf7059",
                  "workspaceId": "855ce463-047f-4fd0-9e3e-5ed6faccee5e"
                }
              }
            },
            "type": "DataWarehouseTable",
            "schema": [],
            "typeProperties": {}
          }
        }
      },
      {
        "name": "foreach_updates",
        "description": "Do incremental/upsert load from fabric views to salesforce table for each source",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "filter_updates",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('filter_updates').output.value",
            "type": "Expression"
          },
          "isSequential": true,
          "activities": [
            {
              "name": "updates_fabric_salesforce",
              "description": "Update data from fabric to salesforce objects",
              "type": "Copy",
              "dependsOn": [
                {
                  "activity": "set_lastmoddate",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "source": {
                  "type": "DataWarehouseSource",
                  "sqlReaderQuery": {
                    "value": "SELECT *\nFROM \n(\nSELECT @{item().Table_Fields} \nFROM @{item().Source_Schema}.@{item().Source_Table_Name}\n@{item().Join_Definition} \nWHERE \n(\nTRY_CONVERT(varchar(50), @{item().Watermark_Fields}) = ''\n)\nOR\n(\n    CASE WHEN CAST(@{item().Watermark_Fields} AS VARCHAR(20)) \n             LIKE '[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9].%'\n        THEN\n            CAST(LEFT(CAST(@{item().Watermark_Fields} AS VARCHAR(20)), 8) AS DATE)\n        ELSE\n            CAST(CAST(@{item().Watermark_Fields} AS VARCHAR(20)) AS DATE) END > DATEADD(DAY, -3, CAST('@{variables('v_LastModifiedDate')}' AS DATE))\n            )\n) Src\nWHERE Src.@{item().Primary_Key} IS NOT NULL \nAND EXISTS \n(\n        SELECT 1\n        FROM @{item().Source_Schema}.@{item().Target_Table_Name} Sf\n        WHERE Src.@{item().Primary_Key} = Sf.@{item().Primary_Key}\n)",
                    "type": "Expression"
                  },
                  "queryTimeout": "02:00:00",
                  "partitionOption": "None",
                  "datasetSettings": {
                    "annotations": [],
                    "linkedService": {
                      "name": "Salesforce_WH",
                      "properties": {
                        "annotations": [],
                        "type": "DataWarehouse",
                        "typeProperties": {
                          "endpoint": "cx2knzbh2yrejngvheequwseqy-mpsfzbl7atie7hr6l3lpvtholy.datawarehouse.fabric.microsoft.com",
                          "artifactId": "adfe4a3b-9adc-4661-a8b7-f4ef7fcf7059",
                          "workspaceId": "855ce463-047f-4fd0-9e3e-5ed6faccee5e"
                        }
                      }
                    },
                    "type": "DataWarehouseTable",
                    "schema": [],
                    "typeProperties": {}
                  }
                },
                "sink": {
                  "type": "SalesforceSink",
                  "writeBatchSize": 100000,
                  "writeBehavior": "upsert",
                  "externalIdFieldName": {
                    "value": "@item().Primary_Key",
                    "type": "Expression"
                  },
                  "ignoreNullValues": false,
                  "datasetSettings": {
                    "annotations": [],
                    "type": "SalesforceObject",
                    "schema": [],
                    "typeProperties": {
                      "objectApiName": {
                        "value": "@item().Target_Table_Name",
                        "type": "Expression"
                      }
                    },
                    "externalReferences": {
                      "connection": "37551f20-232c-4133-ae10-9b04df2d6f7f"
                    }
                  }
                },
                "enableStaging": false,
                "enableSkipIncompatibleRow": false,
                "translator": {
                  "type": "TabularTranslator",
                  "typeConversion": true,
                  "typeConversionSettings": {
                    "allowDataTruncation": true,
                    "treatBooleanAsNumber": false
                  }
                }
              }
            },
            {
              "name": "lkp_get_lastmoddate",
              "type": "Lookup",
              "dependsOn": [
                {
                  "activity": "logstart",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "source": {
                  "type": "DataWarehouseSource",
                  "sqlReaderQuery": {
                    "value": "SELECT\n    CAST(MAX(LastModifiedDate) AS DATE) AS LastRunDate\nFROM @{item().Source_Schema}.@{item().Target_Table_Name}",
                    "type": "Expression"
                  },
                  "queryTimeout": "02:00:00",
                  "partitionOption": "None"
                },
                "datasetSettings": {
                  "annotations": [],
                  "linkedService": {
                    "name": "Salesforce_WH",
                    "properties": {
                      "annotations": [],
                      "type": "DataWarehouse",
                      "typeProperties": {
                        "endpoint": "cx2knzbh2yrejngvheequwseqy-mpsfzbl7atie7hr6l3lpvtholy.datawarehouse.fabric.microsoft.com",
                        "artifactId": "adfe4a3b-9adc-4661-a8b7-f4ef7fcf7059",
                        "workspaceId": "855ce463-047f-4fd0-9e3e-5ed6faccee5e"
                      }
                    }
                  },
                  "type": "DataWarehouseTable",
                  "schema": [],
                  "typeProperties": {}
                }
              }
            },
            {
              "name": "set_lastmoddate",
              "type": "SetVariable",
              "dependsOn": [
                {
                  "activity": "lkp_get_lastmoddate",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "policy": {
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "variableName": "v_LastModifiedDate",
                "value": {
                  "value": "@activity('lkp_get_lastmoddate').output.firstRow.LastRunDate",
                  "type": "Expression"
                }
              }
            },
            {
              "name": "logstart",
              "type": "Script",
              "dependsOn": [
