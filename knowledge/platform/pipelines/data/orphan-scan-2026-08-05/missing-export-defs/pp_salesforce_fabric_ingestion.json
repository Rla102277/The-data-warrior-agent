{
  "properties": {
    "activities": [
      {
        "name": "lkp_table_list",
        "description": "select salesforce object name, target table name and object fields.",
        "type": "Lookup",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "DataWarehouseSource",
            "sqlReaderQuery": "SELECT Pipeline_Type,\n    Pipeline_Name,\n    Source_Schema,\n    Source_Table_Name,\n    Target_Schema,\n    Target_Table_Name,\n    Table_Fields,\n    Primary_Key,\n    Watermark_Fields,\n    IsActive,\n    Load_Type \nFROM [metadata].[Ingestion_Config] WHERE Pipeline_Type='Inbound';",
            "queryTimeout": "02:00:00",
            "partitionOption": "None"
          },
          "firstRowOnly": false,
          "datasetSettings": {
            "annotations": [],
            "linkedService": {
              "name": "Salesforce_WH",
              "properties": {
                "annotations": [],
                "type": "DataWarehouse",
                "typeProperties": {
                  "endpoint": "cx2knzbh2yrejngvheequwseqy-mpsfzbl7atie7hr6l3lpvtholy.datawarehouse.fabric.microsoft.com",
                  "artifactId": "adfe4a3b-9adc-4661-a8b7-f4ef7fcf7059",
                  "workspaceId": "855ce463-047f-4fd0-9e3e-5ed6faccee5e"
                }
              }
            },
            "type": "DataWarehouseTable",
            "schema": [],
            "typeProperties": {}
          }
        }
      },
      {
        "name": "foreach_salesforceobjects",
        "description": "Run copy activity for each salesforce Objects from lookup.",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "lkp_table_list",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('lkp_table_list').output.value",
            "type": "Expression"
          },
          "isSequential": false,
          "batchCount": 8,
          "activities": [
            {
              "name": "lkp_get_count_from_salesforceobject",
              "description": "Get the count of records present in each SF Object.",
              "type": "Lookup",
              "dependsOn": [],
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "source": {
                  "type": "SalesforceSource",
                  "query": {
                    "value": "Select count(Id) totalcount from @{item().Source_Table_Name}\n",
                    "type": "Expression"
                  },
                  "includeDeletedObjects": false,
                  "partitionOption": "AutoDetect"
                },
                "firstRowOnly": true,
                "datasetSettings": {
                  "annotations": [],
                  "type": "SalesforceObject",
                  "schema": [],
                  "typeProperties": {},
                  "externalReferences": {
                    "connection": "37551f20-232c-4133-ae10-9b04df2d6f7f"
                  }
                }
              }
            },
            {
              "name": "If_data_exists",
              "description": "Check if the data present in SF object, If date present then copy it to warehouse else we are not doing any copy.",
              "type": "IfCondition",
              "dependsOn": [
                {
                  "activity": "lkp_get_count_from_salesforceobject",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "typeProperties": {
                "expression": {
                  "value": "@greater(activity('lkp_get_count_from_salesforceobject').output.firstRow.totalCount, 0)\n",
                  "type": "Expression"
                },
                "ifFalseActivities": [],
                "ifTrueActivities": [
                  {
                    "name": "copy_salesforce_fabric",
                    "description": "Copy objects from salesforce to fabric warehouse tables.",
                    "type": "Copy",
                    "dependsOn": [],
                    "policy": {
                      "timeout": "0.12:00:00",
                      "retry": 0,
                      "retryIntervalInSeconds": 30,
                      "secureOutput": false,
                      "secureInput": false
                    },
                    "typeProperties": {
                      "source": {
                        "type": "SalesforceSource",
                        "query": {
                          "value": "Select @{item().Table_Fields} from @{item().Source_Table_Name}\n",
                          "type": "Expression"
                        },
                        "includeDeletedObjects": false,
                        "partitionOption": "AutoDetect",
                        "datasetSettings": {
                          "annotations": [],
                          "type": "SalesforceObject",
                          "schema": [],
                          "typeProperties": {},
                          "externalReferences": {
                            "connection": "37551f20-232c-4133-ae10-9b04df2d6f7f"
                          }
                        }
                      },
                      "sink": {
                        "type": "DataWarehouseSink",
                        "preCopyScript": {
                          "value": "truncate table @{item().Target_Schema}.@{item().Target_Table_Name}",
                          "type": "Expression"
                        },
                        "allowCopyCommand": true,
                        "copyCommandSettings": {},
                        "disableMetricsCollection": false,
                        "datasetSettings": {
                          "annotations": [],
                          "linkedService": {
                            "name": "Salesforce_WH",
                            "properties": {
                              "annotations": [],
                              "type": "DataWarehouse",
                              "typeProperties": {
                                "endpoint": "cx2knzbh2yrejngvheequwseqy-mpsfzbl7atie7hr6l3lpvtholy.datawarehouse.fabric.microsoft.com",
                                "artifactId": "adfe4a3b-9adc-4661-a8b7-f4ef7fcf7059",
                                "workspaceId": "855ce463-047f-4fd0-9e3e-5ed6faccee5e"
                              }
                            }
                          },
                          "type": "DataWarehouseTable",
                          "schema": [],
                          "typeProperties": {
                            "schema": {
                              "value": "@item().Target_Schema",
                              "type": "Expression"
                            },
                            "table": {
                              "value": "@item().Target_Table_Name",
                              "type": "Expression"
                            }
                          }
                        }
                      },
                      "enableStaging": true,
                      "parallelCopies": 1,
                      "translator": {
                        "type": "TabularTranslator",
                        "typeConversion": true,
                        "typeConversionSettings": {
                          "allowDataTruncation": true,
                          "treatBooleanAsNumber": false
                        }
                      }
                    }
                  },
                  {
                    "name": "log_succed",
                    "description": "Insert the success log entries to Pipeline_Table_Load_Log table.",
                    "type": "Script",
                    "dependsOn": [
                      {
                        "activity": "copy_salesforce_fabric",
                        "dependencyConditions": [
                          "Succeeded"
                        ]
                      }
                    ],
                    "policy": {
                      "timeout": "0.12:00:00",
                      "retry": 0,
                      "retryIntervalInSeconds": 30,
                      "secureOutput": false,
                      "secureInput": false
                    },
                    "linkedService": {
                      "name": "Salesforce_WH",
                      "properties": {
                        "annotations": [],
                        "type": "DataWarehouse",
                        "typeProperties": {
                          "endpoint": "cx2knzbh2yrejngvheequwseqy-mpsfzbl7atie7hr6l3lpvtholy.datawarehouse.fabric.microsoft.com",
                          "artifactId": "adfe4a3b-9adc-4661-a8b7-f4ef7fcf7059",
                          "workspaceId": "855ce463-047f-4fd0-9e3e-5ed6faccee5e"
                        }
                      }
                    },
                    "typeProperties": {
                      "scripts": [
                        {
                          "type": "Query",
                          "text": {
                            "value": "INSERT INTO logging.Pipeline_Table_Load_Log\n(\n    PipelineRunId,\n    PipelineName,\n    PipelineType,\n    TargetSystem,\n    LoadType,\n    TableName,\n    ActivityName,\n    RunDateTime,\n    RunStatus,\n    RowsRead,\n    RowsWritten,\n    RowsSkipped,\n    CopyDuration, \n    ErrorMessage\n)\nVALUES\n(\n    '@{pipeline().RunId}',\n    '@{pipeline().Pipeline}',\n    '@{item().Pipeline_Type}',\n    'Fabric WH',\n    '@{item().Load_Type}',\n    '@{item().Target_Table_Name}',\n    'copy_salesforce_fabric',\n    SYSUTCDATETIME(),\n    'Success',\n    '@{activity('copy_salesforce_fabric').output.rowsRead}',\n    '@{activity('copy_salesforce_fabric').output.rowsCopied}',\n     NULL,\n    '@{activity('copy_salesforce_fabric').output.copyDuration}',\n    NULL\n);",
                            "type": "Expression"
                          }
                        }
                      ],
                      "scriptBlockExecutionTimeout": "02:00:00"
                    }
                  },
                  {
                    "name": "log_failure",
                    "description": "Insert the failure log entries to Pipeline_Table_Load_Log table.",
                    "type": "Script",
                    "dependsOn": [
                      {
                        "activity": "copy_salesforce_fabric",
                        "dependencyConditions": [
                          "Failed"
                        ]
                      }
                    ],
                    "policy": {
                      "timeout": "0.12:00:00",
                      "retry": 0,
                      "retryIntervalInSeconds": 30,
                      "secureOutput": false,
                      "secureInput": false
                    },
                    "linkedService": {
                      "name": "Salesforce_WH",
                      "properties": {
                        "annotations": [],
                        "type": "DataWarehouse",
                        "typeProperties": {
                          "endpoint": "cx2knzbh2yrejngvheequwseqy-mpsfzbl7atie7hr6l3lpvtholy.datawarehouse.fabric.microsoft.com",
                          "artifactId": "adfe4a3b-9adc-4661-a8b7-f4ef7fcf7059",
                          "workspaceId": "855ce463-047f-4fd0-9e3e-5ed6faccee5e"
                        }
                      }
                    },
                    "typeProperties": {
                      "scripts": [
                        {
                          "type": "Query",
                          "text": {
                            "value": "INSERT INTO logging.Pipeline_Table_Load_Log\n(\n    PipelineRunId,\n    PipelineName,\n    PipelineType,\n    TargetSystem,\n    LoadType,\n    TableName,\n    ActivityName,\n    RunDateTime,\n    RunStatus,\n    RowsRead,\n    RowsWritten,\n    RowsSkipped,\n    CopyDuration, \n    ErrorMessage,\n)\nVALUES\n(\n    '@{pipeline().RunId}',\n    '@{pipeline().Pipeline}',\n    '@{item().Pipeline_Type}',\n    'Fabric WH',\n    '@{item().Load_Type}',\n    '@{item().Target_Table_Name}',\n    'copy_salesforce_fabric',\n    SYSUTCDATETIME(),\n    'Failed',\n    NULL,\n    NULL,\n    NULL,\n    NULL,\n    '@{replace(coalesce(activity('copy_salesforce_fabric').error.message, 'Unknown error'), '''', '''''')}'\n);\n",
                            "type": "Expression"
                          }
                        }
                      ],
                      "scriptBlockExecutionTimeout": "02:00:00"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ],
    "folder": {
      "name": "Ingestion/Ingestion"
    }
  }
}