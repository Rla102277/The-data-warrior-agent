{
  "properties": {
    "activities": [
      {
        "name": "lkp_get_tablelist",
        "description": "Get the fabric views table name and details from Ingestion_Config table.",
        "type": "Lookup",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "DataWarehouseSource",
            "sqlReaderQuery": "SELECT \n    Pipeline_Type,\n    Pipeline_Name,\n    Source_Schema,\n    Source_Table_Name,\n    Target_Schema,\n    Target_Table_Name,\n    Table_Fields,\n    Primary_Key,\n    Join_Definition,\n    Watermark_Fields,\n    IsActive,\n    Load_Type,\n    Order_Of_Execution\nFROM [metadata].[Ingestion_Config] WHERE Pipeline_Type='Outbound' \nORDER BY Order_Of_Execution;",
            "queryTimeout": "02:00:00",
            "partitionOption": "None"
          },
          "firstRowOnly": false,
          "datasetSettings": {
            "annotations": [],
            "linkedService": {
              "name": "Salesforce_WH",
              "properties": {
                "annotations": [],
                "type": "DataWarehouse",
                "typeProperties": {
                  "endpoint": "cx2knzbh2yrejngvheequwseqy-mpsfzbl7atie7hr6l3lpvtholy.datawarehouse.fabric.microsoft.com",
                  "artifactId": "adfe4a3b-9adc-4661-a8b7-f4ef7fcf7059",
                  "workspaceId": "855ce463-047f-4fd0-9e3e-5ed6faccee5e"
                }
              }
            },
            "type": "DataWarehouseTable",
            "schema": [],
            "typeProperties": {}
          }
        }
      },
      {
        "name": "foreach",
        "description": "Update/Insert from views tables table for each SF object.",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "lkp_get_tablelist",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('lkp_get_tablelist').output.value",
            "type": "Expression"
          },
          "isSequential": true,
          "activities": [
            {
              "name": "switch_load_type",
              "description": "Execute based on Load_Type",
              "type": "Switch",
              "dependsOn": [],
              "typeProperties": {
                "on": {
                  "value": "@item().Load_Type",
                  "type": "Expression"
                },
                "cases": [
                  {
                    "value": "Update",
                    "activities": [
                      {
                        "name": "updates_fabric_salesforce",
                        "description": "Update data from fabric to salesforce objects.",
                        "type": "Copy",
                        "dependsOn": [],
                        "policy": {
                          "timeout": "0.12:00:00",
                          "retry": 0,
                          "retryIntervalInSeconds": 30,
                          "secureOutput": false,
                          "secureInput": false
                        },
                        "typeProperties": {
                          "source": {
                            "type": "DataWarehouseSource",
                            "sqlReaderQuery": {
                              "value": "SELECT *\nFROM \n(\nSELECT @{item().Table_Fields} \nFROM @{item().Source_Schema}.@{item().Source_Table_Name}\n@{item().Join_Definition} \n) Src\nWHERE Src.@{item().Primary_Key} IS NOT NULL \nAND EXISTS \n(\n        SELECT 1\n        FROM @{item().Source_Schema}.@{item().Target_Table_Name} Sf\n        WHERE Src.@{item().Primary_Key} = Sf.@{item().Primary_Key}\n);",
                              "type": "Expression"
                            },
                            "queryTimeout": "02:00:00",
                            "partitionOption": "None",
                            "datasetSettings": {
                              "annotations": [],
                              "linkedService": {
                                "name": "Salesforce_WH",
                                "properties": {
                                  "annotations": [],
                                  "type": "DataWarehouse",
                                  "typeProperties": {
                                    "endpoint": "cx2knzbh2yrejngvheequwseqy-mpsfzbl7atie7hr6l3lpvtholy.datawarehouse.fabric.microsoft.com",
                                    "artifactId": "adfe4a3b-9adc-4661-a8b7-f4ef7fcf7059",
                                    "workspaceId": "855ce463-047f-4fd0-9e3e-5ed6faccee5e"
                                  }
                                }
                              },
                              "type": "DataWarehouseTable",
                              "schema": [],
                              "typeProperties": {}
                            }
                          },
                          "sink": {
                            "type": "SalesforceSink",
                            "writeBatchSize": 100000,
                            "writeBehavior": "upsert",
                            "externalIdFieldName": "@item().Primary_Key",
                            "ignoreNullValues": false,
                            "datasetSettings": {
                              "annotations": [],
                              "type": "SalesforceObject",
                              "schema": [],
                              "typeProperties": {
                                "objectApiName": "@item().Target_Table_Name"
                              },
                              "externalReferences": {
                                "connection": "207e8644-adf2-4e53-97d7-b14f9679bce4"
                              }
                            }
                          },
                          "enableStaging": false,
                          "enableSkipIncompatibleRow": true,
                          "translator": {
                            "type": "TabularTranslator",
                            "typeConversion": true,
                            "typeConversionSettings": {
                              "allowDataTruncation": true,
                              "treatBooleanAsNumber": false
                            }
                          }
                        }
                      },
                      {
                        "name": "log_succed_update",
                        "description": "Insert the success log entries to Pipeline_Table_Load_Log table.",
                        "type": "Script",
                        "dependsOn": [
                          {
                            "activity": "updates_fabric_salesforce",
                            "dependencyConditions": [
                              "Succeeded"
                            ]
                          }
                        ],
                        "policy": {
                          "timeout": "0.12:00:00",
                          "retry": 0,
                          "retryIntervalInSeconds": 30,
                          "secureOutput": false,
                          "secureInput": false
                        },
                        "linkedService": {
                          "name": "Salesforce_WH",
                          "properties": {
                            "annotations": [],
                            "type": "DataWarehouse",
                            "typeProperties": {
                              "endpoint": "cx2knzbh2yrejngvheequwseqy-mpsfzbl7atie7hr6l3lpvtholy.datawarehouse.fabric.microsoft.com",
                              "artifactId": "adfe4a3b-9adc-4661-a8b7-f4ef7fcf7059",
                              "workspaceId": "855ce463-047f-4fd0-9e3e-5ed6faccee5e"
                            }
                          }
                        },
                        "typeProperties": {
                          "scripts": [
                            {
                              "type": "Query",
                              "text": {
                                "value": "INSERT INTO logging.Pipeline_Table_Load_Log\n(\n    PipelineRunId,\n    PipelineName,\n    PipelineType,\n    TargetSystem,\n    LoadType,\n    TableName,\n    ActivityName,\n    RunDateTime,\n    RunStatus,\n    RowsRead,\n    RowsWritten,\n    RowsSkipped,\n    CopyDuration, \n    ErrorMessage\n)\nVALUES\n(\n    '@{pipeline().RunId}',\n    '@{pipeline().Pipeline}',\n    '@{item().Pipeline_Type}',\n    'Salesforce',\n    '@{item().Load_Type}',\n    '@{item().Target_Table_Name}',\n    'updates_fabric_salesforce',\n    SYSUTCDATETIME(),\n    'Success',\n    '@{activity('updates_fabric_salesforce').output.rowsRead}',\n    '@{activity('updates_fabric_salesforce').output.rowsCopied}',\n    NULL,\n    '@{activity('updates_fabric_salesforce').output.copyDuration}',\n    NULL\n);",
                                "type": "Expression"
                              }
                            }
                          ],
                          "scriptBlockExecutionTimeout": "02:00:00"
                        }
                      },
                      {
                        "name": "log_failure_update",
                        "description": "Insert the failed log entries to Pipeline_Table_Load_Log table.",
                        "type": "Script",
                        "dependsOn": [
