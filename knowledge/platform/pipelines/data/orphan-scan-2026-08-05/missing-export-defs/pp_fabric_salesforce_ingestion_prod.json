                              "workspaceId": "855ce463-047f-4fd0-9e3e-5ed6faccee5e"
                            }
                          }
                        },
                        "typeProperties": {
                          "scripts": [
                            {
                              "type": "Query",
                              "text": {
                                "value": "INSERT INTO logging.Pipeline_Table_Load_Log\n(\n    PipelineRunId,\n    PipelineName,\n    PipelineType,\n    TargetSystem,\n    LoadType,\n    TableName,\n    ActivityName,\n    RunDateTime,\n    RunStatus,\n    RowsRead,\n    RowsWritten,\n    RowsSkipped,\n    CopyDuration, \n    ErrorMessage\n)\nVALUES\n(\n    '@{pipeline().RunId}',\n    '@{pipeline().Pipeline}',\n    '@{item().Pipeline_Type}',\n    'Salesforce',\n    '@{item().Load_Type}',\n    '@{item().Target_Table_Name}',\n    'updates_fabric_salesforce',\n    SYSUTCDATETIME(),\n    'Failed',\n    NULL,\n    NULL,\n    NULL,\n    NULL,\n    '@{replace(coalesce(activity('updates_fabric_salesforce').error.message, 'Unknown error'), '''', '''''')}'\n);\n",
                                "type": "Expression"
                              }
                            }
                          ],
                          "scriptBlockExecutionTimeout": "02:00:00"
                        }
                      }
                    ]
                  },
