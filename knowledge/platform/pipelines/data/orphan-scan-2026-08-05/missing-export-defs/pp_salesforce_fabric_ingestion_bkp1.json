{
  "properties": {
    "activities": [
      {
        "name": "lkp_table_list",
        "description": "select salesforce object name, target table name and object fields ",
        "type": "Lookup",
        "state": "Inactive",
        "onInactiveMarkAs": "Succeeded",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "DataWarehouseSource",
            "sqlReaderQuery": "SELECT Pipeline_Type,\n    Pipeline_Name,\n    Source_Schema,\n    Source_Table_Name,\n    Target_Schema,\n    Target_Table_Name,\n    Table_Fields,\n    Primary_Key,\n    Watermark_Fields,\n    IsActive,\n    Load_Type \nFROM [metadata].[Ingestion_Config] WHERE Pipeline_Type='Inbound';",
            "queryTimeout": "02:00:00",
            "partitionOption": "None"
          },
          "firstRowOnly": false,
          "datasetSettings": {
            "annotations": [],
            "linkedService": {
              "name": "Salesforce_WH",
              "properties": {
                "annotations": [],
                "type": "DataWarehouse",
                "typeProperties": {
                  "endpoint": "cx2knzbh2yrejngvheequwseqy-mpsfzbl7atie7hr6l3lpvtholy.datawarehouse.fabric.microsoft.com",
                  "artifactId": "adfe4a3b-9adc-4661-a8b7-f4ef7fcf7059",
                  "workspaceId": "855ce463-047f-4fd0-9e3e-5ed6faccee5e"
                }
              }
            },
            "type": "DataWarehouseTable",
            "schema": [],
            "typeProperties": {}
          }
        }
      },
      {
        "name": "foreach_salesforceobjects",
        "description": "Run copy activity for each salesforce Objects from lookup ",
        "type": "ForEach",
        "state": "Inactive",
        "onInactiveMarkAs": "Succeeded",
        "dependsOn": [
          {
            "activity": "lkp_table_list",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('lkp_table_list').output.value",
            "type": "Expression"
          },
          "isSequential": true,
          "activities": [
            {
              "name": "lkp_get_count_from_salesforceobject",
              "type": "Lookup",
              "dependsOn": [],
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "source": {
                  "type": "SalesforceSource",
                  "query": {
                    "value": "Select count(Id) totalcount from @{item().Source_Table_Name}\n",
                    "type": "Expression"
                  },
                  "includeDeletedObjects": false,
                  "partitionOption": "AutoDetect"
                },
                "firstRowOnly": true,
                "datasetSettings": {
                  "annotations": [],
                  "type": "SalesforceObject",
                  "schema": [],
                  "typeProperties": {},
                  "externalReferences": {
                    "connection": "37551f20-232c-4133-ae10-9b04df2d6f7f"
                  }
                }
              }
            },
            {
              "name": "If_data_exists",
              "type": "IfCondition",
              "dependsOn": [
                {
                  "activity": "lkp_get_count_from_salesforceobject",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "typeProperties": {
                "expression": {
                  "value": "@greater(activity('lkp_get_count_from_salesforceobject').output.firstRow.totalCount, 0)\n",
                  "type": "Expression"
                },
                "ifFalseActivities": [],
                "ifTrueActivities": [
                  {
                    "name": "copy_salesforce_fabric",
                    "description": "Copy objects from salesforce to fabric warehouse tables.",
                    "type": "Copy",
                    "dependsOn": [
                      {
                        "activity": "logstart",
                        "dependencyConditions": [
                          "Succeeded"
                        ]
                      }
                    ],
                    "policy": {
                      "timeout": "0.12:00:00",
                      "retry": 0,
                      "retryIntervalInSeconds": 30,
                      "secureOutput": false,
                      "secureInput": false
                    },
                    "typeProperties": {
                      "source": {
                        "type": "SalesforceSource",
                        "query": {
                          "value": "Select @{item().Table_Fields} from @{item().Source_Table_Name}\n",
                          "type": "Expression"
                        },
                        "includeDeletedObjects": false,
                        "partitionOption": "AutoDetect",
                        "datasetSettings": {
                          "annotations": [],
                          "type": "SalesforceObject",
                          "schema": [],
                          "typeProperties": {},
                          "externalReferences": {
                            "connection": "37551f20-232c-4133-ae10-9b04df2d6f7f"
                          }
                        }
                      },
                      "sink": {
                        "type": "DataWarehouseSink",
                        "preCopyScript": {
                          "value": "truncate table @{item().Target_Schema}.@{item().Target_Table_Name}",
                          "type": "Expression"
                        },
                        "allowCopyCommand": true,
                        "copyCommandSettings": {},
                        "disableMetricsCollection": false,
                        "datasetSettings": {
                          "annotations": [],
                          "linkedService": {
                            "name": "Salesforce_WH",
                            "properties": {
                              "annotations": [],
                              "type": "DataWarehouse",
                              "typeProperties": {
                                "endpoint": "cx2knzbh2yrejngvheequwseqy-mpsfzbl7atie7hr6l3lpvtholy.datawarehouse.fabric.microsoft.com",
                                "artifactId": "adfe4a3b-9adc-4661-a8b7-f4ef7fcf7059",
                                "workspaceId": "855ce463-047f-4fd0-9e3e-5ed6faccee5e"
                              }
                            }
                          },
                          "type": "DataWarehouseTable",
                          "schema": [],
                          "typeProperties": {
                            "schema": {
                              "value": "@item().Target_Schema",
                              "type": "Expression"
                            },
                            "table": {
                              "value": "@item().Target_Table_Name",
                              "type": "Expression"
                            }
                          }
                        }
                      },
                      "enableStaging": true,
                      "parallelCopies": 1,
                      "translator": {
                        "type": "TabularTranslator",
                        "typeConversion": true,
                        "typeConversionSettings": {
                          "allowDataTruncation": true,
                          "treatBooleanAsNumber": false
                        }
                      }
                    }
                  },
                  {
                    "name": "logstart",
                    "type": "Script",
                    "dependsOn": [
                      {
                        "activity": "set_logid",
                        "dependencyConditions": [
                          "Succeeded"
                        ]
                      }
                    ],
                    "policy": {
                      "timeout": "0.12:00:00",
                      "retry": 0,
                      "retryIntervalInSeconds": 30,
                      "secureOutput": false,
                      "secureInput": false
                    },
                    "linkedService": {
                      "name": "Salesforce_WH",
                      "properties": {
                        "annotations": [],
                        "type": "DataWarehouse",
                        "typeProperties": {
                          "endpoint": "cx2knzbh2yrejngvheequwseqy-mpsfzbl7atie7hr6l3lpvtholy.datawarehouse.fabric.microsoft.com",
                          "artifactId": "adfe4a3b-9adc-4661-a8b7-f4ef7fcf7059",
                          "workspaceId": "855ce463-047f-4fd0-9e3e-5ed6faccee5e"
                        }
                      }
                    },
                    "typeProperties": {
                      "scripts": [
                        {
                          "type": "Query",
                          "text": {
                            "value": "INSERT INTO logging.Pipeline_Table_Run_Log\n(\n    LogId,\n    PipelineName,\n    PipelineType,\n    TargetSystem,\n    LoadType,\n    PipelineRunId,\n    TableName,\n    ActivityName,\n    StartTime,\n    RunStatus,\n    CreatedDatetime\n)\nVALUES\n(\n    '@{variables('LogId')}',\n    '@{pipeline().Pipeline}',\n    '@{item().Pipeline_Type}',\n    'Fabric WH',\n    '@{item().Load_Type}',\n    '@{pipeline().RunId}',\n    '@{item().Target_Table_Name}',\n    'Copy_To_Salesforce',\n    SYSUTCDATETIME(),\n    'Started',\n    SYSUTCDATETIME()\n);\n",
                            "type": "Expression"
                          }
                        }
                      ],
                      "scriptBlockExecutionTimeout": "02:00:00"
                    }
                  },
                  {
                    "name": "set_logid",
                    "type": "SetVariable",
                    "dependsOn": [],
                    "policy": {
                      "secureOutput": false,
                      "secureInput": false
                    },
                    "typeProperties": {
                      "variableName": "LogId",
                      "value": {
                        "value": "@{guid()}",
                        "type": "Expression"
                      }
                    }
                  },
                  {
                    "name": "log_succed",
                    "type": "Script",
                    "dependsOn": [
                      {
                        "activity": "copy_salesforce_fabric",
                        "dependencyConditions": [
                          "Succeeded"
                        ]
                      }
                    ],
                    "policy": {
                      "timeout": "0.12:00:00",
                      "retry": 0,
                      "retryIntervalInSeconds": 30,
                      "secureOutput": false,
                      "secureInput": false
                    },
                    "linkedService": {
                      "name": "Salesforce_WH",
                      "properties": {
                        "annotations": [],
                        "type": "DataWarehouse",
                        "typeProperties": {
                          "endpoint": "cx2knzbh2yrejngvheequwseqy-mpsfzbl7atie7hr6l3lpvtholy.datawarehouse.fabric.microsoft.com",
                          "artifactId": "adfe4a3b-9adc-4661-a8b7-f4ef7fcf7059",
                          "workspaceId": "855ce463-047f-4fd0-9e3e-5ed6faccee5e"
                        }
                      }
                    },
                    "typeProperties": {
                      "scripts": [
                        {
                          "type": "Query",
                          "text": {
                            "value": "UPDATE logging.Pipeline_Table_Run_Log\nSET\n    EndTime = SYSUTCDATETIME(),\n    RunStatus = 'Success',\n    RowsRead = @{activity('copy_salesforce_fabric').output.rowsRead},\n    RowsWritten = @{activity('copy_salesforce_fabric').output.rowsCopied}\nWHERE \n    LogId = '@{variables('LogId')}'\n    AND PipelineRunId = '@{pipeline().RunId}'\n    AND TableName = '@{item().Target_Table_Name}'\n    AND RunStatus = 'Started';\n",
                            "type": "Expression"
                          }
                        }
                      ],
                      "scriptBlockExecutionTimeout": "02:00:00"
                    }
                  },
                  {
                    "name": "log_failure",
                    "type": "Script",
                    "dependsOn": [
                      {
                        "activity": "copy_salesforce_fabric",
                        "dependencyConditions": [
                          "Failed"
                        ]
                      }
                    ],
                    "policy": {
                      "timeout": "0.12:00:00",
                      "retry": 0,
                      "retryIntervalInSeconds": 30,
                      "secureOutput": false,
                      "secureInput": false
                    },
                    "linkedService": {
                      "name": "Salesforce_WH",
                      "properties": {
                        "annotations": [],
                        "type": "DataWarehouse",
                        "typeProperties": {
                          "endpoint": "cx2knzbh2yrejngvheequwseqy-mpsfzbl7atie7hr6l3lpvtholy.datawarehouse.fabric.microsoft.com",
                          "artifactId": "adfe4a3b-9adc-4661-a8b7-f4ef7fcf7059",
                          "workspaceId": "855ce463-047f-4fd0-9e3e-5ed6faccee5e"
                        }
                      }
                    },
                    "typeProperties": {
                      "scripts": [
                        {
                          "type": "Query",
                          "text": {
                            "value": "UPDATE logging.Pipeline_Table_Run_Log\nSET\n    EndTime = SYSUTCDATETIME(),\n    RunStatus = 'Failed',\n    ErrorMessage = '@{replace(coalesce(activity('copy_salesforce_fabric').error.message, 'Unknown error'), '''', '''''')}'\nWHERE\n    LogId = '@{variables('LogId')}'\n    AND PipelineRunId = '@{pipeline().RunId}'\n    AND TableName = '@{item().Target_Table_Name}'\n    AND RunStatus = 'Started';\n",
                            "type": "Expression"
                          }
                        }
                      ],
                      "scriptBlockExecutionTimeout": "02:00:00"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
