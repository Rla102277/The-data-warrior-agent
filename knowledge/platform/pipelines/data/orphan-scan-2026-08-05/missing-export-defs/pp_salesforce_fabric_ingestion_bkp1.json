              "treatBooleanAsNumber": false
            }
          }
        }
      }
    ],
    "variables": {
      "v_LastModifiedDate": {
        "type": "String",
        "defaultValue": "1900-01-01T00:00:00Z"
      },
      "LogId": {
        "type": "String"
      }
    },
    "folder": {
      "name": "Ingestion/Ingestion"
    }
  }
}