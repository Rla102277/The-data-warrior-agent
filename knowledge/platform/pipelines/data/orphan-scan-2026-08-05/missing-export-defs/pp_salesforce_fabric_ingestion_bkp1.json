              }
            }
          },
          "sink": {
            "type": "DataWarehouseSink",
            "allowCopyCommand": true,
            "copyCommandSettings": {},
            "tableOption": "autoCreate",
            "disableMetricsCollection": false,
            "datasetSettings": {
              "annotations": [],
              "linkedService": {
                "name": "Salesforce_WH",
                "properties": {
                  "annotations": [],
